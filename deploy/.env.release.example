STUDIO_SERVER_IMAGE=studio-server:release
STUDIO_EDGE_IMAGE=studio-edge:release
STUDIO_LICENSE_DIR=./license
STUDIO_TLS_DIR=./tls
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_HTTPS_PORT=443
STUDIO_MIGRATION_DATABASE_URL=mysql+pymysql://migrator:change-me@mysql.example/studio

ENVIRONMENT=production
DEPLOYMENT_MODE=saas
INSTALLATION_ID=
PAID_CALLS_PAUSED=true
DATABASE_URL=mysql+pymysql://studio:change-me@mysql.example/studio
REDIS_URL=redis://:change-me@redis.example:6379/0
AUTH_PUBLIC_ORIGIN=https://studio.example
AUTH_TOTP_KEY=
STORAGE_ENDPOINT=https://objects.example
STORAGE_SIGNED_ENDPOINT=
STORAGE_BUCKET=studio-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
