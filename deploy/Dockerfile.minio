FROM python:3.12-slim AS download

ARG TARGETARCH
# Official MinIO 2024-12-18T13-15-44Z release assets and published SHA-256 values.
RUN python - "$TARGETARCH" <<'PY'
import hashlib
import pathlib
import sys
import urllib.request

assets = {
    "amd64": (404668345, "88182336ab5793488f2caad54846056b330f0dcb5c488b60d52434beeebae3ca"),
    "arm64": (404668139, "455c9b3093b7c1e6153c85cfd745c7c401a92497346ba24dbe45775c7b3ab1cd"),
}
asset, expected = assets[sys.argv[1]]
url = f"https://api.github.com/repos/minio/minio/releases/assets/{asset}?download=1"
request = urllib.request.Request(url, headers={"Accept": "application/octet-stream"})
with urllib.request.urlopen(request, timeout=120) as response:
    binary = response.read()
if hashlib.sha256(binary).hexdigest() != expected:
    raise SystemExit("MinIO release checksum mismatch")
path = pathlib.Path("/minio")
path.write_bytes(binary)
path.chmod(0o755)
PY

FROM scratch
COPY --from=download /minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
