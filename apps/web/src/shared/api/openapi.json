  "components": {
    "schemas": {
      "CategoryFields": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "apparel",
              "beauty",
              "home",
              "digital"
            ],
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FactField"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "fields"
        ],
        "title": "CategoryFields"
      },
      "ConfirmedFact": {
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Value"
          },
          "evidence": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "evidence"
        ],
        "title": "ConfirmedFact"
      },
      "Credentials": {
        "properties": {
          "tenant_slug": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$",
            "title": "Tenant Slug"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "otp": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6,
                "minLength": 6,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Otp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_slug",
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CurrentSession": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantInfo"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "type": "array",
            "title": "Permissions"
          },
